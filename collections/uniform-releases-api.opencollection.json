          "info": {
            "name": "GET /api/v1/releases",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/releases",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of records to skip"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Max number of records to return"
              },
              {
                "name": "keyword",
                "value": "",
                "type": "query",
                "description": "Matches releases where their name contains the specified keyword\n"
              },
              {
                "name": "states",
                "value": "",
                "type": "query",
                "description": "Matches releases where their state is one of a list\n"
              },
              {
                "name": "scheduleStates",
                "value": "",
                "type": "query",
                "description": "Matches releases by whether an auto-launch schedule is set\n"
              },
              {
                "name": "releaseIDs",
                "value": "",
                "type": "query",
                "description": "Matches releases where their ID is one of a list\n"
              },
              {
                "name": "orderBy",
                "value": "",
                "type": "query",
                "description": "Sets the sorting of the results. If unspecified, results are sorted by launch(ed) date descending, and then by name ascending.\nAllowed values are: auto_launch_schedule_DESC, auto_launch_schedule_ASC, launched_at_DESC, launched_at_ASC, name_DESC, name_ASC\n"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
