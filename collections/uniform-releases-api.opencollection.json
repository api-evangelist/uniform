              },
              {
                "name": "releaseId",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of records to skip\nThis is a list query parameter, and cannot be used with any primary query parameters\n"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Max number of records to return\nThis is a list query parameter, and cannot be used with any primary query parameters\n"
              },
              {
                "name": "publicIDs",
                "value": "",
                "type": "query",
                "description": "Matches release contents where their public ID is one of a list\n"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists all contents (adds, moves, deletes) of a release"
        },
