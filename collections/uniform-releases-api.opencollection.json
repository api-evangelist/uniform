    {
      "info": {
        "name": "Releases",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /api/v1/entity-releases",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/entity-releases",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "query"
              },
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "Matches entity by their ID\n"
              },
              {
                "name": "definitionType",
                "value": "",
                "type": "query",
                "description": "Entity type (i.e. composition, entry, ...).\nNOTE: New values may be added to this list without being considered a breaking API change\n"
              },
              {
                "name": "releaseStates",
                "value": "",
                "type": "query",
                "description": "Matches entity instances where their release state is one of a list. NOTE: base instance, when present, is always included in the results.\n"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of records to skip\n"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return\n"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists entity instances across all releases (and base). Default to draft state if entity supports it."
        },
        {
          "info": {
            "name": "GET /api/v1/release-contents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/release-contents",
            "params": [
              {
                "name": "projectId",
                "value": "",
