          "info": {
            "name": "GET /api/v1/projects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/projects",
            "params": [
              {
                "name": "teamId",
                "value": "",
                "type": "query",
                "description": "If provided, only return the specified team and its projects. If omitted, return all accessible teams."
              },
              {
                "name": "orderBy",
                "value": "",
                "type": "query",
                "description": "Sort order for projects within each team. Defaults to name_ASC."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Lists projects grouped by team. If teamId is provided, returns a single team with its projects. If omitted, returns all accessible teams and their projects."
